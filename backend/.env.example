# Concept2Motion Environment Configuration

# 1. Meta Open-Weight Model Provider - Fireworks AI
# Serves Meta Llama 3.3 70B Instruct or Llama 3.1 8B
FIREWORKS_API_KEY=""
FIREWORKS_MODEL="accounts/fireworks/models/llama-v3p3-70b-instruct"

# 2. Meta Open-Weight Model Provider - Baseten (Alternative)
# Serves custom or dedicated Meta Llama models
BASETEN_API_KEY=""
BASETEN_MODEL_ID=""

# 3. Isolated Sandboxed Execution - Modal
# Runs generated simulation code in remote ephemeral containers
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""

# 4. Meta Multimodal Models (Muse Spark / Muse Image)
# Optional developer credentials for Meta direct endpoints
META_API_KEY=""

PORT=4000
